{%
	function has_ble_config() {
		return length(ble) > 0;
	}

	function generate_ibeacon_config(output) {
		if (!ble.ibeacon)
			return;

		uci_named_section(output, 'ble.ibeacon', 'ble');
		uci_set_boolean(output, 'ble.ibeacon.enabled', ble.ibeacon.enabled);
		uci_set_string(output, 'ble.ibeacon.uuid', ble.ibeacon.uuid);
		uci_set_number(output, 'ble.ibeacon.major', ble.ibeacon.major);
		uci_set_number(output, 'ble.ibeacon.minor', ble.ibeacon.minor);
		uci_set_number(output, 'ble.ibeacon.txpower', ble.ibeacon.txpower);
	}

	function generate_scan_config(output) {
		if (!ble.scan)
			return;

		uci_named_section(output, 'ble.scan', 'ble');
		uci_set_boolean(output, 'ble.scan.enabled', ble.scan.enabled);
		uci_set_string(output, 'ble.scan.filter', ble.scan.filter);
	}

	function generate_ble_config() {
		if (!has_ble_config())
			return '';

		let output = [];

		uci_comment(output, '# generated by ble.uc');
		uci_comment(output, '### generate BLE configuration');
		generate_ibeacon_config(output);
		generate_scan_config(output);

		return uci_output(output);
	}
%}

{{ generate_ble_config() }}
