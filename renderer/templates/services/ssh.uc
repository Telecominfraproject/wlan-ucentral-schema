{%
	// Variables initialization
	// The service object is {} when the config lists "ssh" on an interface
	// without a services.ssh block, so the schema defaults never get applied.
	// Fall back to the schema defaults here so the firewall rule always has a
	// port and the brute-force guard is always rendered.
	let port = ssh.port ?? 22;
	let rate_limit = ssh.connection_rate_limit ?? 6;
	let ban_failures = ssh.ban_after_failures ?? 9;
	let ban_duration = ssh.ban_duration ?? 10;

	// Helper functions
	function has_ssh_interfaces() {
		let interfaces = services.lookup_interfaces("ssh");

		return length(interfaces) > 0;
	}

	function has_authorized_keys() {
		return ssh.authorized_keys && length(ssh.authorized_keys) > 0;
	}

	function has_rate_limit() {
		return rate_limit > 0;
	}

	// The failure-count ban is enforced by ucentral-sshguard, which fills
	// the ban sets from dropbear's "dropbear.auth" ubus events.
	function has_ban() {
		return ban_failures > 0 && services.is_present('ucentral-sshguard');
	}

	function is_ssh_restricted() {
		return restrict.ssh && has_ssh_interfaces();
	}

	function get_ssh_interfaces() {
		return services.lookup_interfaces("ssh");
	}

	// Configuration generation functions
	function generate_ssh_config() {
		let interfaces = get_ssh_interfaces();
		let enable = has_ssh_interfaces();

		if (is_ssh_restricted()) {
			warn('SSH is restricted');
			return '';
		}

		services.set_enabled("dropbear", enable);

		if (!enable)
			return '';

		let output = [];

		uci_comment(output, '# generated by ssh.uc');
		uci_comment(output, '### generate SSH service configuration');
		uci_set_boolean(output, 'dropbear.@dropbear[-1].enable', enable);
		uci_set_string(output, 'dropbear.@dropbear[-1].Port', port);
		uci_set_boolean(output, 'dropbear.@dropbear[-1].PasswordAuth', ssh.password_authentication);
		uci_set_number(output, 'dropbear.@dropbear[-1].IdleTimeout', ssh.idle_timeout);
		// Authentication attempts allowed per connection before dropbear
		// closes it. Set explicitly instead of relying on the init script
		// default so the brute-force bound (connection-rate-limit x
		// MaxAuthTries) is defined by this template.
		uci_set_number(output, 'dropbear.@dropbear[-1].MaxAuthTries', 3);

		return uci_output(output);
	}

	function generate_firewall_rules() {
		let interfaces = get_ssh_interfaces();
		let enable = has_ssh_interfaces();

		if (is_ssh_restricted() || !enable)
			return '';

		let output = [];

		uci_comment(output, '### generate SSH firewall rules');

		for (let interface in interfaces) {
			let name = ethernet.calculate_name(interface);
			uci_section(output, 'firewall rule');
			uci_set_string(output, 'firewall.@rule[-1].name', 'Allow-ssh-' + name);
			uci_set_string(output, 'firewall.@rule[-1].src', name);
			uci_set_string(output, 'firewall.@rule[-1].dest_port', port);
			uci_set_string(output, 'firewall.@rule[-1].proto', 'tcp');
			uci_set_string(output, 'firewall.@rule[-1].target', 'ACCEPT');
		}

		return uci_output(output);
	}

	// SSH brute-force guard, enforced by nftables:
	//  - ban: drop new SSH connections from sources that ucentral-sshguard
	//    added to ssh_ban4/ssh_ban6 after repeated authentication failures
	//  - rate limit: per-source bound on new SSH connections, which holds
	//    across reconnection
	// The sets are shared by every SSH zone; the rule file is included at the
	// head of each zone's input chain so it runs before the Allow-ssh ACCEPT
	// rule, and the ban rule runs before the rate limit.
	function generate_guard() {
		let interfaces = get_ssh_interfaces();
		let enable = has_ssh_interfaces();

		if (is_ssh_restricted() || !enable || (!has_rate_limit() && !has_ban()))
			return '';

		let sets = '';
		let rules = '';

		if (has_ban()) {
			sets +=
				'set ssh_ban4 {\n' +
				'\ttype ipv4_addr\n' +
				'\tflags timeout\n' +
				'}\n' +
				'set ssh_ban6 {\n' +
				'\ttype ipv6_addr\n' +
				'\tflags timeout\n' +
				'}\n';
			rules +=
				`tcp dport ${port} ip saddr @ssh_ban4 counter drop comment "ssh ban"\n` +
				`tcp dport ${port} ip6 saddr @ssh_ban6 counter drop comment "ssh ban"\n`;
		}

		if (has_rate_limit()) {
			sets +=
				'set ssh_guard4 {\n' +
				'\ttype ipv4_addr\n' +
				'\tflags dynamic,timeout\n' +
				'\ttimeout 10m\n' +
				'\tsize 65535\n' +
				'}\n' +
				'set ssh_guard6 {\n' +
				'\ttype ipv6_addr\n' +
				'\tflags dynamic,timeout\n' +
				'\ttimeout 10m\n' +
				'\tsize 65535\n' +
				'}\n';
			// "update" refreshes the element timeout on every new connection,
			// so a source that keeps connecting keeps its (empty) bucket
			rules +=
				`tcp dport ${port} ct state new update @ssh_guard4 { ip saddr limit rate over ${rate_limit}/minute burst ${rate_limit} packets } counter drop comment "ssh brute-force guard"\n` +
				`tcp dport ${port} ct state new update @ssh_guard6 { ip6 saddr limit rate over ${rate_limit}/minute burst ${rate_limit} packets } counter drop comment "ssh brute-force guard"\n`;
		}

		files.add_named('/etc/ucentral/ssh-guard-sets.nft', sets);
		files.add_named('/etc/ucentral/ssh-guard-rules.nft', rules);

		let output = [];

		uci_comment(output, '### generate SSH brute-force guard');

		uci_section(output, 'firewall include');
		uci_set_string(output, 'firewall.@include[-1].type', 'nftables');
		uci_set_string(output, 'firewall.@include[-1].position', 'table-pre');
		uci_set_string(output, 'firewall.@include[-1].path', '/etc/ucentral/ssh-guard-sets.nft');

		for (let interface in interfaces) {
			let name = ethernet.calculate_name(interface);
			uci_section(output, 'firewall include');
			uci_set_string(output, 'firewall.@include[-1].type', 'nftables');
			uci_set_string(output, 'firewall.@include[-1].position', 'chain-pre');
			uci_set_string(output, 'firewall.@include[-1].chain', 'input_' + name);
			uci_set_string(output, 'firewall.@include[-1].path', '/etc/ucentral/ssh-guard-rules.nft');
		}

		return uci_output(output);
	}

	// Configuration for ucentral-sshguard. Rendered on every apply when the
	// package is present, so disabling SSH or the ban stops the daemon.
	function generate_ban_config() {
		if (!services.is_present('ucentral-sshguard'))
			return '';

		let enable = has_ssh_interfaces() && !is_ssh_restricted() && has_ban();
		let output = [];

		// 'no-restart': start it when it is not running, but keep a running
		// daemon (and its failure counts); new thresholds reach it through
		// the init script's reload trigger
		services.set_enabled('ucentral-sshguard', enable ? 'no-restart' : false);

		uci_comment(output, '### generate SSH failure-count ban configuration');
		uci_named_section(output, 'sshguard.main', 'sshguard');
		uci_set_boolean(output, 'sshguard.main.enabled', enable);
		if (enable) {
			uci_set_number(output, 'sshguard.main.failures', ban_failures);
			uci_set_number(output, 'sshguard.main.window', ban_duration);
			uci_set_number(output, 'sshguard.main.ban_time', ban_duration);
		}

		return uci_output(output);
	}

	function generate_authorized_keys() {
		let enable = has_ssh_interfaces();

		if (is_ssh_restricted() || !enable || !has_authorized_keys())
			return;

		files.add_named("/etc/dropbear/authorized_keys", join("\n", ssh.authorized_keys) + "\n");
	}

	// Main logic
	if (!has_ssh_interfaces())
		return;

	generate_authorized_keys();
%}

{{ generate_ssh_config() }}
{{ generate_firewall_rules() }}
{{ generate_guard() }}
{{ generate_ban_config() }}
