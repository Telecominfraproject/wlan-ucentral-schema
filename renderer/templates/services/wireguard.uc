{%
// SPDX-License-Identifier: BSD-3-Clause

	// Helper functions

	function has_wireguard_config() {
		return length(wireguard) > 0;
	}

	function is_auto_prefix(prefix) {
		return index(prefix, 'auto/') == 0;
	}

	// uc-cidr4 accepts auto/<n>, which netifd cannot use
	function has_auto_prefix() {
		if (is_auto_prefix(wireguard.address))
			return true;

		for (let peer in wireguard.peers) {
			if (peer.disable)
				continue;

			for (let allowed_ip in peer.allowed_ips)
				if (is_auto_prefix(allowed_ip))
					return true;
		}

		return false;
	}

	/**
	 * Downstream IPv4 interfaces whose traffic is routed into the tunnel.
	 * Upstream interfaces and interfaces without IPv4 are skipped with a warning.
	 */
	function lookup_tunnelled_interfaces() {
		let rv = [];

		for (let interface in services.lookup_interfaces('wireguard')) {
			let name = ethernet.calculate_name(interface);

			if (interface.role != 'downstream') {
				warn('wireguard is only supported on downstream interfaces, skipping %s', name);
				continue;
			}

			if ((interface.ipv4?.addressing || 'none') == 'none') {
				warn('wireguard requires IPv4, skipping %s', name);
				continue;
			}

			push(rv, interface);
		}

		return rv;
	}

	// Configuration generation functions
	function generate_interface(table) {
		let output = [];

		uci_comment(output, '# generated by wireguard.uc');
		uci_comment(output, '### generate wireguard interface');
		uci_named_section(output, 'network.wg0', 'interface');
		uci_set_string(output, 'network.wg0.proto', 'wireguard');
		uci_set_string(output, 'network.wg0.private_key', wireguard.private_key);
		uci_list_string(output, 'network.wg0.addresses', wireguard.address);
		uci_set_number(output, 'network.wg0.mtu', wireguard.mtu);
		uci_set_number(output, 'network.wg0.listen_port', wireguard.listen_port);
		uci_set_string(output, 'network.wg0.ip4table', table);

		return uci_output(output);
	}

	function generate_peers() {
		let output = [];

		uci_comment(output, '### generate wireguard peers');
		for (let peer in wireguard.peers) {
			uci_section(output, 'network wireguard_wg0');
			uci_set_string(output, 'network.@wireguard_wg0[-1].description', peer.name);
			uci_set_string(output, 'network.@wireguard_wg0[-1].public_key', peer.public_key);
			uci_set_string(output, 'network.@wireguard_wg0[-1].preshared_key', peer.preshared_key);
			uci_set_string(output, 'network.@wireguard_wg0[-1].endpoint_host', peer.endpoint.host);
			uci_set_number(output, 'network.@wireguard_wg0[-1].endpoint_port', peer.endpoint.port);
			for (let allowed_ip in peer.allowed_ips)
				uci_list_string(output, 'network.@wireguard_wg0[-1].allowed_ips', allowed_ip);
			uci_set_boolean(output, 'network.@wireguard_wg0[-1].route_allowed_ips', true);
			if (peer.persistent_keepalive)
				uci_set_number(output, 'network.@wireguard_wg0[-1].persistent_keepalive', peer.persistent_keepalive);
			if (peer.disable)
				uci_set_boolean(output, 'network.@wireguard_wg0[-1].disabled', true);
		}

		return uci_output(output);
	}

	function generate_zone() {
		let output = [];

		uci_comment(output, '### generate wireguard firewall zone');
		uci_section(output, 'firewall zone');
		uci_set_string(output, 'firewall.@zone[-1].name', 'wg0');
		uci_list_string(output, 'firewall.@zone[-1].network', 'wg0');
		uci_set_string(output, 'firewall.@zone[-1].input', 'REJECT');
		uci_set_string(output, 'firewall.@zone[-1].output', 'ACCEPT');
		uci_set_string(output, 'firewall.@zone[-1].forward', 'REJECT');
		uci_set_number(output, 'firewall.@zone[-1].masq', 1);
		uci_set_number(output, 'firewall.@zone[-1].mtu_fix', 1);

		return uci_output(output);
	}

	function generate_routing(interfaces, table) {
		let output = [];

		uci_comment(output, '### generate wireguard forwarding and routing rules');
		for (let interface in interfaces) {
			uci_section(output, 'firewall forwarding');
			uci_set_string(output, 'firewall.@forwarding[-1].src', ethernet.calculate_name(interface));
			uci_set_string(output, 'firewall.@forwarding[-1].dest', 'wg0');

			uci_section(output, 'network rule');
			uci_set_string(output, 'network.@rule[-1].in', ethernet.calculate_ipv4_name(interface));
			uci_set_string(output, 'network.@rule[-1].lookup', table);
		}

		return uci_output(output);
	}

	// Main logic
	if (!has_wireguard_config()) {
		for (let interface in services.lookup_interfaces('wireguard'))
			warn('%s lists wireguard but services.wireguard is not configured', ethernet.calculate_name(interface));
		return;
	}

	if (has_auto_prefix()) {
		warn('wireguard does not support auto/ prefixes in address or allowed-ips, skipping the service');
		return;
	}

	let table = routing_table.get('wireguard');
	let interfaces = lookup_tunnelled_interfaces();
%}
{{ generate_interface(table) }}
{{ generate_peers() }}
{{ generate_zone() }}
{{ generate_routing(interfaces, table) }}
