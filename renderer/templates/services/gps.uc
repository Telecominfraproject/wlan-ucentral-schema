{%
	// Helper functions
	function has_ugps_service() {
		return services.is_present("ugps");
	}

	function has_gps_config() {
		return length(gps) > 0;
	}

	function get_committed_gps_config() {
		cursor.load("gps");

		return cursor.get_all("gps", "@gps[-1]");
	}

	// Compare the settings this template is about to write with the ones
	// already committed in /etc/config/gps. Only options that are written
	// below take part in the comparison; uci values are strings.
	function gps_config_changed(enable) {
		let current = get_committed_gps_config();

		if (!current)
			return true;

		// ugps treats a missing disabled option as 0
		if ((current.disabled ?? '0') != (enable ? '0' : '1'))
			return true;

		if (!enable)
			return false;

		if (gps.adjust_time != null &&
		    (current.adjust_time ?? '0') != (gps.adjust_time ? '1' : '0'))
			return true;

		if (gps.baud_rate != null && current.baudrate != '' + gps.baud_rate)
			return true;

		return false;
	}

	// Configuration generation functions
	function generate_gps_config() {
		let output = [];

		uci_comment(output, '# generated by gps.uc');

		if (!has_gps_config()) {
			// No services.gps in the configuration: disable GPS explicitly.
			uci_comment(output, '### GPS not configured - keep it disabled');
			uci_set_number(output, 'gps.@gps[-1].disabled', 1);

			return uci_output(output);
		}

		uci_comment(output, '### generate GPS configuration');
		uci_set_number(output, 'gps.@gps[-1].disabled', 0);
		uci_set_boolean(output, 'gps.@gps[-1].adjust_time', gps.adjust_time);
		uci_set_string(output, 'gps.@gps[-1].baudrate', gps.baud_rate);

		return uci_output(output);
	}

	// Main logic
	// Only boards that ship ugps have /etc/config/gps to write to.
	if (!has_ugps_service())
		return;

	let enable = has_gps_config();
	let changed = gps_config_changed(enable);

	// ugps reads gps.@gps[-1].disabled when it starts: stop it before the
	// commit when GPS is not configured, restart it afterwards when it is.
	services.set_enabled("ugps", enable);

	// ucentral-gps applies the board specific GPIO state from the committed
	// gps.@gps[-1].disabled value. Keep it after ugps to match the boot
	// order (S80 ugps, S99 ucentral-gps).
	if (changed && services.is_present("ucentral-gps"))
		services.set_enabled("ucentral-gps", true);
%}

{{ generate_gps_config() }}
